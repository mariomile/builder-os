#!/usr/bin/env bash
# SessionStart hook for BuilderOS plugin. Emits one host-specific JSON object.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
hub_content=$(cat "${PLUGIN_ROOT}/skills/using-builder-os/SKILL.md")

# Quote one path for the Bash shell used by the hook, including apostrophes.
shell_quote() {
  printf '%q' "$1"
}

# Encode JSON without requiring Node. Escape every JSON control character.
escape_for_json() {
  local s="$1" char escaped i
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  for ((i=1; i<32; i++)); do
    printf -v char '%b' "\\$(printf '%03o' "$i")"
    printf -v escaped '\\u%04x' "$i"
    s="${s//"$char"/$escaped}"
  done
  printf '%s' "$s"
}

session_context="You have BuilderOS installed — The Operating System for Product Builders.

**BuilderOS installation root:** ${PLUGIN_ROOT}
Resolve support paths (skills/, references/, scripts/) from this installation root, never the user's project. Run commands from the user's project so artifacts and state stay there. On Claude Code plugin skills and agents use the builder-os: namespace.

**The using-builder-os skill is already loaded below.** Apply it only within the user's requested scope and existing authorization; load other skills as needed:

${hub_content}"

if command -v node >/dev/null 2>&1; then
  script_command="node $(shell_quote "${PLUGIN_ROOT}/scripts/bos.mjs")"
  session_context+="

**BuilderOS script:** \`${script_command}\`. Use this quoted path for scripts/bos.mjs (gate, record, run-check, defer-review, new, cover, brief, roadmap, migrate) from the user's project root."
fi

if [ -d ".builderos" ] && command -v node >/dev/null 2>&1; then
  if brief_out=$(node "${PLUGIN_ROOT}/scripts/bos.mjs" brief 2>&1); then
    session_context+="

**Project memory briefing:**

${brief_out}"
  else
    session_context+="

**Project memory briefing unavailable:** ${brief_out}
Inspect the project memory before lifecycle work; do not infer state from a failed briefing."
  fi
fi

context_json=$(escape_for_json "$session_context")
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$context_json"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$context_json"
else
  printf '{"additionalContext":"%s"}\n' "$context_json"
fi
