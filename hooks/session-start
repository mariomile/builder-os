#!/usr/bin/env bash
# SessionStart hook for BuilderOS plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the BuilderOS bootstrap skill: it routes between the lifecycle and the analysis surface
hub_content=$(cat "${PLUGIN_ROOT}/skills/using-builder-os/SKILL.md" 2>&1 || echo "Error reading BuilderOS bootstrap skill")

# Escape string for JSON embedding
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

hub_escaped=$(escape_for_json "$hub_content")
session_context="You have BuilderOS installed — The Operating System for Product Builders.\n\n**Below is the using-builder-os skill, already loaded. It routes to builder-os (the lifecycle) or pm-toolkit (analysis); load those and every other skill by name:**\n\n${hub_escaped}"

# Output context injection — platform-aware
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
