#!/usr/bin/env bash
# SessionStart hook for BuilderOS plugin. Emits one host-specific JSON object.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
rules_content=$(cat "${PLUGIN_ROOT}/hooks/session-context.md")

# Quote one path for the Bash shell used by the hook, including apostrophes.
shell_quote() {
  printf '%q' "$1"
}

# Encode JSON without requiring Node. Escape every JSON control character.
escape_for_json() {
  local s="$1" char escaped i
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  for ((i=1; i<32; i++)); do
    printf -v char '%b' "\\$(printf '%03o' "$i")"
    printf -v escaped '\\u%04x' "$i"
    s="${s//"$char"/$escaped}"
  done
  printf '%s' "$s"
}

script_line=""
if command -v node >/dev/null 2>&1; then
  script_command="node $(shell_quote "${PLUGIN_ROOT}/scripts/bos.mjs")"
  script_line="
**BuilderOS script:** \`${script_command}\` from the user's project root, subcommands (brief, init, new, resume, reframe, jump, cover, upgrade, gate, record, run-check, evidence, review, round, claim, defer-review, watch, pace, roadmap, page, flows, map, doctor, vendor, migrate)."
fi

root_line="**BuilderOS installation root:** ${PLUGIN_ROOT}
Resolve support paths (skills/, references/, scripts/) from this installation root, never the user's project. Run commands from the user's project so artifacts and state stay there. On Claude Code plugin skills and agents use the builder-os: namespace."

# Outside a BuilderOS project the session gets two lines, not the router: the
# plugin is installed per user and most sessions are not product work.
if [ ! -d ".builderos" ]; then
  session_context="BuilderOS is installed: product methods (PRDs and specs, research, metrics and growth analysis, UX and design, stack choices, releases) and a gated lifecycle from an idea to production. For product work, load the BuilderOS skill that fits before answering, or using-builder-os to route; other requests ignore it.

${root_line}${script_line}"
else
  # Briefing first: it is the only part that changes per project, and hosts
  # truncate long context from the end.
  if command -v node >/dev/null 2>&1; then
    if brief_out=$(node "${PLUGIN_ROOT}/scripts/bos.mjs" brief 2>&1); then
      briefing="**Project memory briefing:**

${brief_out}"
    else
      briefing="**Project memory briefing unavailable:** ${brief_out}
Inspect the project memory before lifecycle work; do not infer state from a failed briefing."
    fi
  else
    briefing="**Project memory briefing unavailable:** node is not on PATH. Read .builderos/ROADMAP.md and the active initiative's state.json before lifecycle work."
  fi
  session_context="This project uses BuilderOS — The Operating System for Product Builders.

${briefing}

${rules_content}

${root_line}${script_line}"
fi

context_json=$(escape_for_json "$session_context")
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$context_json"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$context_json"
else
  printf '{"additionalContext":"%s"}\n' "$context_json"
fi
